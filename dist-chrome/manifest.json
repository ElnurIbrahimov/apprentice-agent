{
  "manifest_version": 3,
  "name": "AURA",
  "version": "4.3.0",
  "description": "Your private AI assistant — always present, never clouds.",
  "permissions": ["sidePanel", "contextMenus", "storage", "activeTab", "tabs", "scripting", "unlimitedStorage", "topSites"],
  "optional_permissions": ["tabCapture"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidebar.html" },
  "action": { "default_title": "Open AURA" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["youtube-inject.js"],
      "matches": ["*://www.youtube.com/*"]
    },
    {
      "resources": ["netflix-inject.js"],
      "matches": ["*://www.netflix.com/*"]
    },
    {
      "resources": ["pyodide-worker.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
