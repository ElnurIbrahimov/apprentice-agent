{
  "manifest_version": 3,
  "name": "AURA",
  "version": "1.0.0",
  "description": "Your private, self-hosted AI assistant — always on.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aura@localhost",
      "strict_min_version": "128.0"
    }
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "AURA",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
