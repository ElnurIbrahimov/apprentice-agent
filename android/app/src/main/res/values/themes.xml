<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Light launch theme — the default `values/` bucket. The
        StartupThemeContractTest asserts the contract: light bg
        #F7F8FA + light status bar.
    -->
    <style name="Theme.Aura" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/aura_splash</item>
        <item name="android:statusBarColor">#F7F8FA</item>
        <item name="android:navigationBarColor">#F7F8FA</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
