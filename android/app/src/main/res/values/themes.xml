<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Aura" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Aura is dark-first. Never expose the platform's white launch canvas. -->
        <item name="android:windowBackground">#030303</item>
        <item name="android:statusBarColor">#030303</item>
        <item name="android:navigationBarColor">#030303</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
