<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Block all cleartext (HTTP) traffic. All API calls must use HTTPS.
        This prevents accidental downgrade or MITM on untrusted networks.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>