<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget metadata. 4 columns × 2 rows (the standard 4x2 home-screen
  size on most launchers). resizable lets the user make it bigger.
  The initialLayout points to the layout we just created.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_ask_aura"
    android:previewLayout="@layout/widget_ask_aura"
    android:configure="com.aura.widget.WidgetConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_ask_aura_description" />
