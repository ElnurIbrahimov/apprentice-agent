<?xml version="1.0" encoding="utf-8"?>
<!--
    Window background shown during cold start. The vertical gradient
    matches the launcher icon background (drawable/ic_launcher_background)
    so the transition from icon → splash → Compose surface reads as
    one continuous visual identity rather than a flash of solid color.

    Centered Aura mark is the same star-on-disc as the launcher icon
    (drawable/ic_launcher_foreground) so the user sees the product
    name for the entire boot sequence.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <gradient
                android:angle="270"
                android:startColor="#0E1A2B"
                android:centerColor="#1E2440"
                android:endColor="#3F2A77" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
