<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Aura brand background. Two-stop vertical gradient
        (top: deep teal, bottom: brand violet) — matches the
        AuraTokens sendReady / accent palette so the launcher
        tile reads as part of the product, not a stock Android
        purple (`@android:color/holo_purple`, the previous
        background, was #AA00FF and didn't match anything).
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startY="0"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#0E1A2B" />
                <item android:offset="0.55" android:color="#1E2440" />
                <item android:offset="1.0" android:color="#3F2A77" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
