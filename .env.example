# ============================================================
# AURA Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ============================================================

# === CORE SECURITY (REQUIRED for network exposure) ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AURA_API_KEY=

# Enable API key authentication (true = reject requests without valid AURA_API_KEY)
# Set to true before exposing AURA to any network
# AURA_API_AUTH_ENABLED controls the middleware + route dependency
# WARNING: When false (default for local dev), ALL endpoints are unauthenticated
# including /api/shell/run. Set to true before exposing to any network.
AURA_API_AUTH_ENABLED=true
AURA_API_RATE_LIMIT=60

# CORS origins for API requests (comma-separated)
AURA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === AURA CORE CONFIG ===
# "development" or "production"
AURA_ENV=development

# "SOUL_PERSONAL" or "SOUL_ENTERPRISE"
AURA_SOUL=SOUL_PERSONAL

# Enable proactive awareness mode
AURA_PROACTIVE=false

# Enable extended thinking for reasoning tasks
AURA_THINKING=true

# Humanize responses
AURA_HUMANIZE=true

# Headless mode — set to true on servers without a display.
# Disables screen monitoring, GUI features, and the proactive screen watcher.
# Auto-detected on Linux if $DISPLAY is not set, but set explicitly to be safe.
# AURA_HEADLESS=true

# Enable multi-user mode
AURA_MULTI_USER=false
AURA_DEFAULT_USER_ID=default_user
AURA_SESSION_TIMEOUT_MIN=30

# === DATA PATHS ===
# General data directory for various features
AURA_DATA_DIR=data

# === OLLAMA / CLOUD LLM ===
# Ollama server host (cloud models go through this too)
OLLAMA_HOST=http://localhost:11434

# Ollama Pro API key ($20/month) — required for cloud models
# All 11 cloud models (Kimi, Qwen, MiniMax, DeepSeek, etc.) need this
OLLAMA_API_KEY=

# === MODEL SELECTION ===
# All defaults are cloud models via Ollama Pro. No local GPU needed.
#
# Available cloud models:
#   kimi-k2.5:cloud, nemotron-3-super:cloud, qwen3.5:397b-cloud,
#   qwen3.5:cloud, deepseek-v3.2:cloud, glm-5:cloud,
#   minimax-m2.7:cloud, minimax-m2.5:cloud, qwen3-coder:480b-cloud,
#   qwen3-coder-next:cloud, gpt-oss:120b-cloud

# Fast inference model
MODEL_FAST=nemotron-3-super:cloud

# Reasoning model (primary default model)
MODEL_REASON=kimi-k2.5:cloud

# Code generation model
MODEL_CODE=minimax-m2.7:cloud

# Vision/image understanding model
MODEL_VISION=kimi-k2.5:cloud

# Extended thinking/chain-of-thought model
MODEL_THINK=qwen3.5:397b-cloud

# Long-context model for handling large documents (1M tokens)
MODEL_LONGCTX=minimax-m2.7:cloud

# === MESSAGING ===
# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_token_here

# Telegram allowed users (comma-separated user IDs)
# Get your ID from @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=

# Telegram admin users (comma-separated user IDs)
TELEGRAM_ADMIN_USERS=

# WhatsApp integration (requires Node.js bridge)
ENABLE_WHATSAPP=false
WHATSAPP_WEBSOCKET_URL=ws://localhost:3001

# === TOOLS: EMAIL ===
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
AURA_EMAIL_KEY=your-32-byte-base64-encoded-key
AURA_EMAIL_ADDRESS=your-email@example.com

# === TOOLS: EXTERNAL API INTEGRATIONS ===
# OpenAI API key (for DALL-E and other OpenAI features)
OPENAI_API_KEY=

# HuggingFace API token (for model downloads, embeddings)
HF_TOKEN=

# Tavily API key (for web search — used by TavilyTool)
TAVILY_API_KEY=

# Brave Search API key (for BraveSearchTool)
BRAVE_API_KEY=

# Firecrawl API key (for FirecrawlTool web scraping)
FIRECRAWL_API_KEY=

# SearXNG instance URL (for WebSearchTool, default: http://localhost:8888)
SEARXNG_URL=http://localhost:8888

# === FEATURE TOGGLES ===
# Knowledge Graph Brain (Kuzu-backed)
KG_BRAIN_ENABLED=true
# Skill Library (procedural knowledge)
SKILL_LIBRARY_ENABLED=true
# LIFE_MODELING_ENABLED removed — mesa/aura_life_modeling deleted (2026-03-22)

# === CONSCIOUSNESS MODULES (Advanced Features) ===

# MirrorMind - Self-reflection and awareness
MIRRORMIND_ENABLED=false
MIRRORMIND_THRESHOLD=0.75
MIRRORMIND_MAX_ITERATIONS=2

# Cognitive Theater - Meta-level reasoning
COGNITIVE_THEATER_ENABLED=true

# Reflexion - Self-correction mechanism
REFLEXION_ENABLED=true
REFLEXION_MAX_ATTEMPTS=3

# SynapseForge - Knowledge synthesis
SYNAPSEFORGE_ENABLED=true

# WorldSim - World state simulation
WORLDSIM_ENABLED=true

# === STRATEGIC REASONING ===
# Strategy Bandit - Multi-armed bandit exploration
STRATEGY_BANDIT_ENABLED=true
STRATEGY_BANDIT_EPSILON=0.1
STRATEGY_BANDIT_EVAL_ENABLED=false

# Reasoning Templates - Structured reasoning patterns
REASONING_TEMPLATES_ENABLED=true

# === LEARNING & ADAPTATION ===
# Prompt Evolution - Automatic prompt optimization
PROMPT_EVOLUTION_ENABLED=false
PROMPT_EVOLUTION_INTERVAL=50

# World Model - Internal state tracking and prediction
WORLD_MODEL_ENABLED=true
WORLD_MODEL_DB_PATH=
WORLD_MODEL_EXTRACTION_ENABLED=true
WORLD_MODEL_EXTRACTION_MODEL=
WORLD_MODEL_EXTRACTION_MIN_INTERVAL=5.0

# Proactive Awareness - Anticipatory system monitoring
PROACTIVE_AWARENESS_ENABLED=true
PROACTIVE_AWARENESS_QUICK_AFTER_CHAT=true

# === VISION & IMAGE PROCESSING ===
# Florence-2 vision model support
FLORENCE2_ENABLED=true
