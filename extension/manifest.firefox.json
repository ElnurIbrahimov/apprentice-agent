{
  "manifest_version": 3,
  "name": "AURA",
  "version": "4.3.0",
  "description": "Your private AI assistant — always present, never clouds.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aura@localhost",
      "strict_min_version": "128.0"
    }
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "AURA",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "downloads",
    "offscreen",
    "unlimitedStorage",
    "topSites",
    "notifications",
    "debugger"
  ],
  "optional_permissions": [
    "tabCapture"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
